---
// Wordmark aggiornato dal marchio esistente: la doppia "ll" di "gemelle" sono le due pietre.
interface Props { class?: string }
const { class: className } = Astro.props;
---
<span class:list={['logo', className]}>
  <span class="sr-only">Pietre Gemelle Resort</span>
  <span class="logo-word" aria-hidden="true">pietregeme<span class="logo-ll"><span>l</span><span>l</span></span>e</span>
  <span class="logo-sub" aria-hidden="true">resort</span>
</span>

<style>
  .logo { display: inline-flex; align-items: baseline; gap: 0.45em; line-height: 1; white-space: nowrap; }
  .logo-word { font-family: var(--font-serif); font-size: 1.6em; letter-spacing: -0.01em; }
  .logo-ll { display: inline-flex; gap: 0.07em; margin-inline: 0.03em; color: var(--color-larice); }
  :global([data-header-theme='dark']) .logo-ll,
  :global([data-header-theme='night']) .logo-ll,
  :global([data-header-theme='clear']) .logo-ll { color: var(--color-larice-chiaro); }
  .logo-sub { font-size: 0.72em; font-weight: 500; letter-spacing: 0.08em; opacity: 0.75; }
</style>
