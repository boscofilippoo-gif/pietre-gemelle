---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Pietre from '../components/Pietre.astro';
import Cresta from '../components/Cresta.astro';
import { giornata, recensioni, stagioni, pietre, crediti } from '../data/resort';
const cred = (f: string) => crediti.find((c) => c.file === f);
const alba = cred('territorio/monte-rosa-alba')!;

const quattro = stagioni.map((s) => ({ ...s, href: `/la-valle/${s.slug}/` }));
const [booking, ...altri] = recensioni.punteggi;
const citazione = recensioni.citazioni[0];
---
<Base
  title="Home"
  description="Sedici appartamenti in quattro baite di legno e pietra, con SPA, tra Riva Valdobbia e Alagna Valsesia. Ogni camera guarda il Monte Rosa."
>
  <!-- 1 · Apertura -->
  <section class="hero theme-night" data-theme="clear">
    <div class="hero-media">
      <Foto src="esterni/notte-neve-baite" alt="Le baite di Pietre Gemelle di notte, sotto la neve, con le finestre accese" priority sizes="100vw" class="hero-img" />
    </div>
    <div class="wrap hero-content">
      <p class="eyebrow hero-eyebrow" data-hero>Riva Valdobbia · Alagna Valsesia</p>
      <h1 class="display h1" data-hero>Davanti al<br />Monte Rosa.</h1>
      <p class="lead hero-lead" data-hero>Sedici appartamenti in quattro baite di legno e pietra. Ogni camera guarda la montagna.</p>
      <div class="hero-cta" data-hero>
        <button type="button" class="btn" data-apri-prenota>Verifica disponibilità <span aria-hidden="true">→</span></button>
        <a href="/il-resort/" class="btn btn-ghost">Il resort</a>
      </div>
      <p class="hero-stato" data-stato-chiuso hidden></p>
    </div>
  </section>

  <!-- 2 · Le due pietre (signature) -->
  <section class="pietre-sec theme-light" data-theme="light" data-pin-pietre aria-labelledby="pietre-t">
    <h2 id="pietre-t" class="sr-only">Le due pietre</h2>
    <div class="pietre-stage">
      <Pietre class="pietre-svg" />
      <div class="pietre-frasi">
        <p class="pietre-frase display h3" data-frase>Un masso rotolò giù dal monte<br />e si spaccò in due metà uguali.</p>
        <p class="pietre-frase display h3" data-frase>Le due pietre sono ancora qui,<br />nel nostro giardino. Si guardano da secoli.</p>
        <div class="pietre-frase" data-frase>
          <ul class="pietre-nomi">
            {pietre.nomi.map((n) => <li><span class="display h3">{n.nome}</span><span class="pietre-lingua">{n.lingua}</span></li>)}
          </ul>
          <a href="/il-resort/" class="link-arrow pietre-link">La storia del luogo <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 · Una giornata da noi (servizi raccontati con l'ora reale) -->
  <section class="giornata theme-night" data-theme="night" data-pin-giornata aria-labelledby="giornata-t">
    <div class="giornata-media" aria-hidden="true">
      {giornata.map((m) => (
        <div class="giornata-foto" data-momento-foto><Foto src={m.foto} alt="" sizes="(min-width: 768px) 55vw, 100vw" /></div>
      ))}
    </div>
    <div class="giornata-testo">
      <p class="eyebrow" id="giornata-t">Una giornata da noi</p>
      <p class="giornata-ora">A Riva Valdobbia sono le <strong data-ora-ora>—:—</strong><span data-ora-momento>.</span></p>
      <ol class="giornata-lista">
        {giornata.map((m) => (
          <li data-momento={m.id}>
            <span class="gm-ora">
              {m.id === 'alba' ? <span data-ora-alba>alba</span> : m.titolo}
              <span class="gm-adesso">adesso</span>
            </span>
            <span class="gm-titolo display">{m.id === 'alba' ? 'Alba' : m.id === 'spa' ? 'La SPA' : m.titolo}</span>
            <span class="gm-testo">{m.testo}{m.id === 'sera' && <> Il sole tramonta alle <span data-ora-tramonto>—</span>.</>}</span>
          </li>
        ))}
      </ol>
      <a href="/info-pratiche/" class="link-arrow giornata-link">Tutto quello che c’è da sapere <span aria-hidden="true">→</span></a>
      <p class="credit giornata-credit">Foto dell’alba: <a href={alba.url}>{alba.autore}</a>, {alba.licenza}</p>
    </div>
  </section>

  <!-- 4 · Sedici Quattromila (signature) -->
  <section class="sedici section theme-light" data-theme="light" aria-labelledby="sedici-t">
    <div class="wrap sedici-head">
      <h2 id="sedici-t" class="display h2" data-split>Sedici appartamenti,<br />sedici Quattromila.</h2>
      <p class="lead muted" data-reveal>Ogni appartamento porta il nome di una vetta del Monte Rosa sopra i 4000 metri. Scegliete la vostra.</p>
    </div>
    <div class="wrap sedici-cresta" data-reveal><Cresta modo="indice" /></div>
    <div class="wrap"><a href="/appartamenti/" class="link-arrow" data-reveal>Tutti gli appartamenti <span aria-hidden="true">→</span></a></div>
  </section>

  <!-- 5 · SPA -->
  <section class="spa-teaser theme-dark" data-theme="dark" aria-labelledby="spa-t">
    <div class="spa-img" data-reveal-img>
      <div data-parallax class="spa-img-inner"><Foto src="spa/corridoio-luce" alt="Il corridoio bianco della SPA con una lama di luce arancio sul pavimento" sizes="100vw" /></div>
    </div>
    <div class="wrap spa-testo">
      <p class="eyebrow">SPA</p>
      <h2 id="spa-t" class="display h2" data-split>Legno, pietra,<br />acqua e luce.</h2>
      <p class="lead" data-reveal>Una sequenza di soglie, riservata agli ospiti. Si entra su prenotazione, dalle 16.</p>
      <a href="/spa/" class="link-arrow" data-reveal>Scopri la SPA <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- 6 · Le stagioni -->
  <section class="stagioni section theme-light" data-theme="light" aria-labelledby="stagioni-t">
    <div class="wrap">
      <h2 id="stagioni-t" class="display h2" data-split>Quattro stagioni,<br />una valle.</h2>
    </div>
    <ul class="wrap stagioni-grid">
      {quattro.map((s, i) => (
        <li data-reveal={i * 0.08}>
          <a href={s.href} class="stagione-card">
            <div class="stagione-img"><Foto src={s.foto} alt="" sizes="(min-width: 768px) 25vw, 50vw" /></div>
            <span class="stagione-nome display">{s.nome}</span>
            <span class="stagione-frase">{s.frase}</span>
          </a>
          {cred(s.foto) && <p class="credit stagione-credit">Foto: <a href={cred(s.foto)!.url}>{cred(s.foto)!.autore}</a>, {cred(s.foto)!.licenza}</p>}
        </li>
      ))}
    </ul>
  </section>

  <!-- 7 · Voci degli ospiti -->
  <section class="voci section theme-sand" data-theme="sand" aria-labelledby="voci-t">
    <div class="wrap voci-grid">
      <div>
        <h2 id="voci-t" class="eyebrow">Chi è stato qui</h2>
        <p class="voci-voto display" data-reveal><span>{booking.voto}</span><small>su {booking.su} · {booking.fonte}</small></p>
        <p class="voci-n muted">{booking.numero}, aggiornato al {recensioni.aggiornate}</p>
        <ul class="voci-altri">
          {altri.map((p) => <li><strong>{p.voto}</strong>/{p.su} {p.fonte} <span class="muted">· {p.numero}</span></li>)}
        </ul>
      </div>
      <figure class="voci-quote" data-reveal>
        <blockquote class="display h3">“{citazione.testo}”</blockquote>
        <figcaption>{citazione.autore}, ospite · {citazione.fonte}</figcaption>
        <p class="voci-temi muted">Nelle recensioni tornano sempre {recensioni.temi.slice(0, 4).join(', ')}.</p>
      </figure>
    </div>
  </section>
</Base>

<style>
  /* Apertura */
  .hero { position: relative; min-height: 100svh; display: grid; align-items: end; overflow: hidden; }
  .hero-media { position: absolute; inset: 0; }
  .hero-media :global(img), .hero-media :global(picture) { width: 100%; height: 100%; object-fit: cover; object-position: 40% 60%; display: block; }
  .hero-media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(10 12 14 / 0.25) 0%, rgb(10 12 14 / 0.05) 35%, rgb(10 12 14 / 0.75) 100%); }
  @media (min-width: 768px) {
    .hero { align-items: start; }
    .hero-media::after { background: linear-gradient(200deg, rgb(10 12 14 / 0.65) 0%, rgb(10 12 14 / 0.25) 45%, transparent 65%), linear-gradient(0deg, rgb(10 12 14 / 0.55), transparent 30%); }
    .hero-content { padding-top: clamp(8rem, 18vh, 11rem); display: grid; justify-items: end; text-align: right; }
    .hero-lead { max-width: 26rem; }
    .hero-cta { justify-content: flex-end; }
  }
  .hero-content { position: relative; padding-bottom: clamp(6rem, 12vh, 9rem); padding-top: 8rem; }
  .hero-eyebrow { color: var(--color-larice-chiaro); margin-bottom: 1.25rem; }
  .hero-lead { max-width: 30rem; margin-top: 1.5rem; color: rgb(243 241 236 / 0.88); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2.25rem; }
  .hero-stato { margin-top: 1.5rem; font-size: 0.9rem; color: rgb(243 241 236 / 0.8); }
  @media (max-width: 767px) {
    .hero-content { padding-bottom: 7.5rem; }
    .hero-media::after { background: linear-gradient(180deg, rgb(10 12 14 / 0.4) 0%, rgb(10 12 14 / 0.15) 25%, rgb(10 12 14 / 0.6) 50%, rgb(10 12 14 / 0.9) 100%); }
    .hero-media :global(img) { object-position: 30% 40%; }
  }

  /* Pietre */
  .pietre-sec { height: 100svh; overflow: hidden; }
  .pietre-stage { position: relative; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: clamp(2rem, 5vh, 3.5rem); padding-top: 3rem; }
  .pietre-stage :global(.pietre-svg) { width: min(62vw, 24rem); height: auto; color: var(--color-pietra); overflow: visible; flex: none; }
  .pietre-stage :global(.pietra) { will-change: transform; }
  .pietre-frasi { position: relative; display: grid; place-items: start center; width: 100%; min-height: 15rem; }
  .pietre-frase { grid-area: 1 / 1; text-align: center; width: min(100% - 2rem, 46rem); color: var(--color-granito); }
  .pietre-frase.h3, .pietre-nomi .h3 { font-size: clamp(1.75rem, 3.4vw, 3.1rem); line-height: 1.08; }
  :global(html.js:not(.reduce)) .pietre-frase:not(:first-child) { opacity: 0; }
  .pietre-nomi { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
  .pietre-nomi li { display: grid; gap: 0.1rem; justify-items: center; }
  .pietre-lingua { font-size: 0.75rem; letter-spacing: 0.06em; color: var(--color-larice); font-weight: 560; }
  .pietre-link { margin-top: 1.75rem; color: var(--color-larice); }
  :global(html.reduce) .pietre-sec, :global(html:not(.js)) .pietre-sec { height: auto; padding-block: 6rem; }
  :global(html.reduce) .pietre-frasi, :global(html:not(.js)) .pietre-frasi { position: static; gap: 3rem; margin-top: 3rem; }
  :global(html.reduce) .pietre-frase, :global(html:not(.js)) .pietre-frase { grid-area: auto; }
  :global(html.reduce) .pietre-stage, :global(html:not(.js)) .pietre-stage { display: block; text-align: center; }
  :global(html.reduce) .pietre-stage, :global(html:not(.js)) .pietre-stage { gap: 0; }

  /* Giornata */
  .giornata { position: relative; min-height: 100svh; display: grid; grid-template-columns: 1fr; overflow: hidden; }
  @media (min-width: 900px) { .giornata { grid-template-columns: 1.15fr 1fr; height: 100svh; } }
  .giornata-media { position: relative; min-height: 42svh; }
  .giornata-foto { position: absolute; inset: 0; opacity: 0; transition: opacity 0.9s var(--ease-monte); }
  .giornata-foto :global(img), .giornata-foto :global(picture) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .giornata-foto.is-on { opacity: 1; }
  .giornata-testo { padding: 2.5rem 1rem 3rem; display: flex; flex-direction: column; justify-content: center; }
  @media (min-width: 900px) { .giornata-testo { padding: 6rem clamp(2rem, 5vw, 5rem); } }
  .giornata-ora { margin-top: 0.75rem; font-size: 1rem; color: rgb(243 241 236 / 0.75); }
  .giornata-ora [data-ora-momento]:empty { display: none; }
  .giornata-ora strong { color: var(--color-neve); font-variant-numeric: tabular-nums; font-weight: 600; }
  .giornata-lista { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 0.25rem; }
  .giornata-lista li { display: grid; grid-template-columns: 6.5rem 1fr; column-gap: 1rem; padding: 0.6rem 0; border-top: 1px solid rgb(255 255 255 / 0.1); }
  .giornata-lista li:not(.is-on) .gm-titolo { color: rgb(243 241 236 / 0.6); }
  .gm-titolo { transition: color 0.5s var(--ease-monte); }
  .gm-ora { grid-row: span 2; font-size: 0.8125rem; font-variant-numeric: tabular-nums; color: var(--color-larice-chiaro); padding-top: 0.45rem; display: grid; align-content: start; gap: 0.25rem; }
  .gm-adesso { display: none; width: fit-content; font-size: 0.6875rem; padding: 0.1rem 0.45rem; border-radius: 999px; background: #8e4b25; color: #fff; }
  .is-adesso .gm-adesso { display: inline-block; }
  .gm-titolo { font-size: clamp(1.5rem, 2.2vw, 2rem); line-height: 1.15; }
  .gm-testo { font-size: 0.95rem; color: rgb(243 241 236 / 0.8); max-height: 0; overflow: hidden; transition: max-height 0.6s var(--ease-monte); }
  .is-on .gm-testo { max-height: 6rem; }
  :global(html.reduce) .gm-testo { max-height: none; }
  :global(html.reduce) .giornata-lista li { opacity: 1; }
  .giornata-link { margin-top: 2rem; color: var(--color-larice-chiaro); }
  .giornata-credit { margin-top: 1rem; }
  .stagione-credit { margin-top: 0.35rem; }
  @media (max-width: 899px) {
    .giornata { height: 100svh; grid-template-rows: 30svh 1fr; }
    .giornata-media { min-height: 0; }
    .giornata-testo { justify-content: start; padding: 1.25rem 1rem 6.5rem; }
    .giornata-ora { font-size: 0.9rem; margin-top: 0.4rem; }
    .giornata-lista { margin-top: 0.75rem; gap: 0; }
    .giornata-lista li { grid-template-columns: 4.5rem 1fr; padding: 0.3rem 0; }
    .gm-ora { grid-row: auto; padding-top: 0.3rem; font-size: 0.75rem; }
    .gm-titolo { font-size: 1.2rem; }
    .gm-testo { grid-column: 2; font-size: 0.875rem; }
    .giornata-link { margin-top: 0.75rem; font-size: 0.9rem; }
    .giornata-credit { display: none; }
  }
  :global(html.reduce) .giornata { height: auto; }

  /* Sedici */
  .sedici-head { display: grid; gap: 1.5rem; margin-bottom: clamp(3rem, 6vw, 5rem); }
  @media (min-width: 900px) { .sedici-head { grid-template-columns: 1.4fr 1fr; align-items: end; } }
  .sedici-cresta { margin-bottom: 2rem; }

  /* SPA */
  .spa-teaser { position: relative; padding-bottom: clamp(5rem, 10vw, 8rem); }
  .spa-img { height: clamp(26rem, 80vh, 52rem); overflow: hidden; }
  .spa-img-inner { height: 116%; margin-top: -8%; }
  .spa-img :global(img), .spa-img :global(picture) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .spa-testo { display: grid; gap: 1.25rem; margin-top: clamp(-9rem, -10vw, -5rem); position: relative; max-width: 40rem; margin-left: max(1rem, calc((100% - 84rem) / 2)); padding: 2.5rem 2rem; background: var(--color-granito); }
  @media (max-width: 767px) { .spa-testo { margin-top: -4rem; padding: 2rem 1.25rem; width: calc(100% - 2rem); } }

  /* Stagioni */
  .stagioni-grid { list-style: none; padding: 0; margin-top: clamp(2.5rem, 5vw, 4rem); display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem 1rem; }
  @media (min-width: 900px) { .stagioni-grid { grid-template-columns: repeat(4, 1fr); gap: 1.5rem; } }
  .stagione-card { display: grid; gap: 0.5rem; }
  .stagione-img { aspect-ratio: 3 / 4; overflow: hidden; border-radius: 0.35rem; }
  .stagione-img :global(img), .stagione-img :global(picture) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.2s var(--ease-monte); }
  .stagione-card:hover .stagione-img :global(img) { transform: scale(1.04); }
  .stagione-nome { font-size: clamp(1.6rem, 2.4vw, 2.2rem); margin-top: 0.5rem; }
  .stagione-frase { font-size: 0.9375rem; color: var(--color-ardesia); }

  /* Voci */
  .voci-grid { display: grid; gap: 3rem; }
  @media (min-width: 900px) { .voci-grid { grid-template-columns: 1fr 1.4fr; align-items: center; } }
  .voci-voto { display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap; margin-top: 1rem; }
  .voci-voto span { font-size: clamp(5rem, 12vw, 9rem); line-height: 0.9; }
  .voci-voto small { font-family: var(--font-sans); font-size: 1rem; }
  .voci-n { font-size: 0.875rem; margin-top: 0.5rem; }
  .voci-altri { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 0.35rem; }
  .voci-quote figcaption { margin-top: 1.25rem; font-size: 0.9375rem; color: var(--color-ardesia); }
  .voci-temi { margin-top: 1.5rem; font-size: 0.9375rem; }
</style>
